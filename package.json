{
  "name": "@marcusferrell/birddog",
  "version": "1.14.0",
  "description": "A local-first \"what needs me next?\" inbox for developers: local git, GitHub, Jira and calendar, ranked by plain rules that explain themselves. Zero dependencies, with an MCP server.",
  "type": "module",
  "bin": {
    "birddog": "bin/birddog.mjs"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "CHANGELOG.md",
    "PRIVACY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/birddog.mjs",
    "dev": "node bin/birddog.mjs --open",
    "dev:watch": "node --watch-path=src --watch-path=bin --watch-path=package.json bin/birddog.mjs --dev",
    "test": "node --test \"test/*.test.mjs\"",
    "dev:login": "node dev/login.mjs --open",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "keywords": [
    "dashboard",
    "developer-tools",
    "inbox",
    "local-first",
    "productivity",
    "git",
    "github",
    "jira",
    "calendar",
    "ical",
    "mcp",
    "model-context-protocol",
    "docker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcsalot/birddog.git"
  },
  "homepage": "https://github.com/marcsalot/birddog#readme",
  "bugs": {
    "url": "https://github.com/marcsalot/birddog/issues"
  },
  "author": {
    "name": "Marcus Ferrell",
    "url": "https://github.com/marcsalot"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
