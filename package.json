{
  "name": "bird-dog",
  "version": "0.3.0",
  "description": "A local-first \"what needs me next?\" dashboard for developers. Birddog finds what matters and points at it.",
  "type": "module",
  "bin": {
    "birddog": "bin/birddog.mjs"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/birddog.mjs",
    "dev": "node bin/birddog.mjs --open",
    "dev:watch": "node --watch-path=src --watch-path=bin bin/birddog.mjs --dev",
    "test": "node --test \"test/*.test.mjs\"",
    "dev:login": "node dev/login.mjs --open"
  },
  "keywords": [
    "dashboard",
    "calendar",
    "developer-tools",
    "git",
    "github",
    "inbox",
    "jira",
    "local-first",
    "productivity"
  ],
  "author": "Marcus Ferrell",
  "license": "MIT"
}
